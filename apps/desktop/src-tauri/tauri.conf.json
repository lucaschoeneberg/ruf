{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ruf",
  "version": "../../../package.json",
  "identifier": "org.rufapp.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ruf",
        "width": 340,
        "height": 500,
        "minWidth": 320,
        "minHeight": 440,
        "theme": "Dark",
        "visible": false
      }
    ],
    "security": {
      "capabilities": ["main", "settings"],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://raw.githubusercontent.com; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://raw.githubusercontent.com http://127.0.0.1:1420 ws://127.0.0.1:1420; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Ruf · compact SIP softphone",
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../../native/licenses/": "native-licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh",
        "languages": ["English", "German"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": { "width": 720, "height": 480 },
        "appPosition": { "x": 180, "y": 224 },
        "applicationFolderPosition": { "x": 540, "y": 224 }
      },
      "files": {
        "Resources/de.lproj/InfoPlist.strings": "localizations/de.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "localizations/en.lproj/InfoPlist.strings"
      }
    }
  }
}
