{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Settings window: read shared status and manage saved accounts; no call controls or arbitrary window creation.",
  "windows": ["settings"],
  "permissions": [
    "allow-get-app-info",
    "allow-get-preferences",
    "allow-save-preferences",
    "allow-get-diagnostics",
    "allow-copy-diagnostics",
    "allow-set-account-enabled",
    "allow-get-notification-permission",
    "allow-open-notification-settings",
    "allow-test-notification",
    "allow-get-microphone-permission",
    "allow-request-microphone-permission",
    "allow-open-microphone-settings",
    "allow-start-audio-test",
    "allow-stop-audio-test",
    "allow-select-account",
    "allow-clear-history",
    "allow-open-about-link",
    "allow-get-software-bill",
    "allow-get-contacts-permission",
    "allow-request-contacts-permission",
    "allow-open-contacts-settings",
    "allow-get-engine-snapshot",
    "allow-save-account",
    "allow-reconnect-account",
    "allow-remove-account",
    "allow-configure-account",
    "allow-get-audio-devices",
    "allow-save-sound-settings",
    "allow-preview-ringtone",
    "allow-stop-ringtone-preview",
    "allow-get-desktop-settings",
    "allow-request-notification-permission",
    "allow-save-desktop-settings",
    "allow-settings-ready",
    "allow-quit-app",
    "core:window:allow-destroy",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
