{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Compact phone window: read shared status, select outgoing account, open settings and control calls.",
  "windows": ["main"],
  "permissions": [
    "allow-get-app-info",
    "allow-get-preferences",
    "allow-get-localization",
    "allow-get-desktop-settings",
    "allow-get-notification-permission",
    "allow-get-contacts",
    "allow-refresh-contacts",
    "allow-copy-phone-number",
    "allow-open-contacts-app",
    "allow-get-history",
    "allow-delete-history-entry",
    "allow-clear-history",
    "allow-callback-history",
    "allow-request-contacts-access",
    "allow-get-contacts-permission",
    "allow-request-contacts-permission",
    "allow-open-contacts-settings",
    "allow-set-contact-favorite",
    "allow-get-engine-snapshot",
    "allow-dial",
    "allow-answer",
    "allow-reject",
    "allow-hangup",
    "allow-set-call-muted",
    "allow-set-call-held",
    "allow-transfer-call",
    "allow-start-consultation",
    "allow-switch-call",
    "allow-cancel-consultation",
    "allow-complete-transfer",
    "allow-send-dtmf",
    "allow-select-account",
    "allow-open-settings",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
