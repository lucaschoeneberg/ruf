{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window can configure an ephemeral local test account and control one call.",
  "windows": ["main"],
  "permissions": [
    "allow-get-app-info",
    "allow-configure-account",
    "allow-get-engine-snapshot",
    "allow-dial",
    "allow-answer",
    "allow-hangup"
  ]
}
