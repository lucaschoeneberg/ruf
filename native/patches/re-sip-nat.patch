diff --git a/src/sip/contact.c b/src/sip/contact.c
index 6703384..5adfd4f 100644
--- a/src/sip/contact.c
+++ b/src/sip/contact.c
@@ -12,6 +12,8 @@
 #include <re_sa.h>
 #include <re_msg.h>
 #include <re_sip.h>
+#include <re_tmr.h>
+#include "sip.h"
 
 
 /**
@@ -55,3 +57,99 @@ int sip_contact_print(struct re_printf *pf, const struct sip_contact *contact)
 				  contact->addr,
 				  sip_transp_param(contact->tp));
 }
+
+
+/* Only a successful response to this exact REGISTER may supply a local mapping.
+ * The transaction layer has already matched the unpredictable Via branch.
+ * This is not server authentication: SIP/UDP remains an unencrypted transport. */
+bool sip_nat_validate(const struct sip *sip, const struct sa *local, const struct sa *peer,
+                      const struct sa *sentby, const char *callid, uint32_t cseq,
+                      const struct sip_msg *msg, struct sa *mapped)
+{
+ struct pl received, rport;
+ uint32_t port = 0;
+ struct sa candidate;
+ if (!sip || !local || !peer || !sentby || !callid || !msg || !mapped ||
+     msg->req || msg->tp != SIP_TRANSP_UDP || msg->scode < 200 ||
+     msg->scode >= 300 || pl_strcmp(&msg->cseq.met, "REGISTER") ||
+     pl_strcmp(&msg->callid, callid) || msg->cseq.num != cseq ||
+     !sa_cmp(&msg->src, peer, SA_ALL) || !sa_cmp(&msg->dst, local, SA_ALL) ||
+     !sa_cmp(&msg->via.addr, sentby, SA_ALL)) return false;
+ if (msg_param_decode(&msg->via.params, "rport", &rport) ||
+     !rport.l || rport.l > 5) return false;
+ for (size_t i = 0; i < rport.l; ++i) {
+  if (rport.p[i] < '0' || rport.p[i] > '9') return false;
+  port = port * 10 + (uint32_t)(rport.p[i] - '0');
+ }
+ if (!port || port > 65535) return false;
+ if (msg_param_decode(&msg->via.params, "received", &received)) {
+  struct pl parameter;
+  /* Compatibility with peers omitting received on refresh: this can only
+   * reaffirm a live exact mapping, never infer or resurrect an address.
+   * A present but malformed received parameter must not use this path. */
+  if (!msg_param_exists(&msg->via.params, "received", &parameter)) return false;
+  const uint64_t now = tmr_jiffies();
+  for (size_t i = 0; i < 32; ++i) {
+   const struct sip_nat_mapping *entry = &sip->nat[i];
+   if (entry->until <= now || !sa_cmp(&entry->local, local, SA_ALL) ||
+       !sa_cmp(&entry->peer, peer, SA_ALL) ||
+       !sa_cmp(&entry->mapped, sentby, SA_ALL) || sa_port(&entry->mapped) != port)
+    continue;
+   *mapped = entry->mapped;
+   return true;
+  }
+  return false;
+ }
+ if (sa_set(&candidate, &received, (uint16_t)port) ||
+     sa_af(&candidate) != sa_af(local) || sa_is_any(&candidate) ||
+     sa_is_multicast(&candidate) ||
+     (sa_is_loopback(&candidate) && !sa_is_loopback(local)) ||
+     (sa_af(&candidate) == AF_INET && sa_in(&candidate) == 0xffffffffu))
+  return false;
+ *mapped = candidate;
+ return true;
+}
+
+int sip_nat_set(struct sip *sip, const struct sa *local, const struct sa *peer,
+                const struct sa *mapped, uint32_t lifetime)
+{
+ struct sip_nat_mapping *slot = NULL;
+ const uint64_t now = tmr_jiffies();
+ if (!sip || !local || !peer || !mapped || !lifetime || lifetime > 604800)
+  return EINVAL;
+ for (size_t i = 0; i < 32; ++i) {
+  struct sip_nat_mapping *entry = &sip->nat[i];
+  if (entry->until && sa_cmp(&entry->local, local, SA_ALL) &&
+      sa_cmp(&entry->peer, peer, SA_ALL)) { slot = entry; break; }
+  if (!slot && entry->until <= now) slot = entry;
+ }
+ if (!slot) return ENOSPC;
+ slot->local = *local; slot->peer = *peer; slot->mapped = *mapped;
+ slot->until = now + (uint64_t)lifetime * 1000;
+ return 0;
+}
+
+void sip_nat_addr(struct sip *sip, enum sip_transp tp, const struct sa *local,
+                  const struct sa *peer, struct sa *advertised)
+{
+ *advertised = *local;
+ const struct sip_nat_mapping *fallback = NULL;
+ bool ambiguous = false;
+ const uint64_t now = tmr_jiffies();
+ if (!sip || tp != SIP_TRANSP_UDP || !peer) return;
+ /* A registrar may originate dialogs from a different UDP port. Reuse only
+  * an unambiguous binding learned for this exact socket and the same peer IP.
+  * Never infer mappings across peers or override an exact endpoint match. */
+ for (size_t i = 0; i < 32; ++i) {
+  const struct sip_nat_mapping *entry = &sip->nat[i];
+  if (entry->until <= now || !sa_cmp(&entry->local, local, SA_ALL) ||
+      !sa_cmp(&entry->peer, peer, SA_ADDR)) continue;
+  if (sa_cmp(&entry->peer, peer, SA_ALL)) {
+   *advertised = entry->mapped; return;
+  }
+  if (fallback && !sa_cmp(&fallback->mapped, &entry->mapped, SA_ALL))
+   ambiguous = true;
+  fallback = entry;
+ }
+ if (fallback && !ambiguous) *advertised = fallback->mapped;
+}
