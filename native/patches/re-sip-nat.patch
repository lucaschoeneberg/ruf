+ for (size_t i = 0; i < sizeof(invalid_refresh)/sizeof(invalid_refresh[0]); ++i) {
+  pl_set_str(&msg->via.params, invalid_refresh[i]);
+  TEST_ASSERT(!sip_nat_validate(sip, &local, &peer, &mapped, "nat-test", 7, msg, &result));
+ }
+ pl_set_str(&msg->via.params, ";rport=51000");
+ other = peer; sa_set_port(&other, 5061); msg->src = other;
+ TEST_ASSERT(!sip_nat_validate(sip, &local, &other, &mapped, "nat-test", 7, msg, &result));
+ msg->src = peer;
+ other = local; sa_set_port(&other, 50001); msg->dst = other;
+ TEST_ASSERT(!sip_nat_validate(sip, &other, &peer, &mapped, "nat-test", 7, msg, &result));
+ msg->dst = local;
+ sip_nat_addr(sip, SIP_TRANSP_UDP, &local, &peer, &result);
+ TEST_ASSERT(sa_cmp(&result, &mapped, SA_ALL));
+ sip_nat_addr(sip, SIP_TRANSP_TCP, &local, &peer, &result);
+ TEST_ASSERT(sa_cmp(&result, &local, SA_ALL));
+ other = peer; sa_set_port(&other, 5061);
+ sip_nat_addr(sip, SIP_TRANSP_UDP, &local, &other, &result);
+ TEST_ASSERT(sa_cmp(&result, &mapped, SA_ALL));
+ /* Peer-IP isolation remains strict even for a matching registrar port. */
+ NAT_ERR(sa_set_str(&other, "192.168.50.9", 5060));
+ sip_nat_addr(sip, SIP_TRANSP_UDP, &local, &other, &result);
+ TEST_ASSERT(sa_cmp(&result, &local, SA_ALL));
+ /* Conflicting mappings suppress fallback, exact endpoint always wins. */
+ other = peer; sa_set_port(&other, 5062);
+ struct sa conflicting = mapped; sa_set_port(&conflicting, 52000);
+ NAT_ERR(sip_nat_set(sip, &local, &other, &conflicting, 1));
+ sa_set_port(&other, 5061);
+ sip_nat_addr(sip, SIP_TRANSP_UDP, &local, &other, &result);
+ TEST_ASSERT(sa_cmp(&result, &local, SA_ALL));
+ sip_nat_addr(sip, SIP_TRANSP_UDP, &local, &peer, &result);
+ TEST_ASSERT(sa_cmp(&result, &mapped, SA_ALL));
+ sys_msleep(1100);
+ /* An expired tuple cannot be resurrected by an incomplete refresh. */
+ msg->src = peer; sa_set_port(&msg->src, 5062); msg->via.addr = conflicting;
+ pl_set_str(&msg->via.params, ";rport=52000");
+ TEST_ASSERT(!sip_nat_validate(sip, &local, &msg->src, &conflicting, "nat-test", 7, msg, &result));
+ sip_nat_addr(sip, SIP_TRANSP_UDP, &local, &other, &result);
+ TEST_ASSERT(sa_cmp(&result, &mapped, SA_ALL));
+ other = local; sa_set_port(&other, 50001);
+ sip_nat_addr(sip, SIP_TRANSP_UDP, &other, &peer, &result);
+ TEST_ASSERT(sa_cmp(&result, &other, SA_ALL));
+ /* Fill the bounded table, retain the live first mapping on exhaustion. */
+ for (unsigned i = 1; i < 32; ++i) {
+  other = peer; sa_set_port(&other, (uint16_t)(5060+i));
+  NAT_ERR(sip_nat_set(sip, &local, &other, &mapped, 120));
+ }
+ other = peer; sa_set_port(&other, 6000);
+ TEST_ASSERT(sip_nat_set(sip, &local, &other, &mapped, 120) == ENOSPC);
+ sip_nat_addr(sip, SIP_TRANSP_UDP, &local, &peer, &result);
+ TEST_ASSERT(sa_cmp(&result, &mapped, SA_ALL));
+ out:
+ mem_deref(msg); mem_deref(mb); mem_deref(sip);
+ return err;
+}
+
+#undef NAT_ERR
+
+
+struct nat_registration_test {
+ struct udp_sock *server;
+ struct sip *sip;
+ struct sipreg *reg;
+ struct tmr stop;
+ unsigned requests, removals, completed;
+ uint16_t port;
+ bool bounce, omit_received, delete_combined, binding_deleted;
+ unsigned single_contact;
+ int error;
+};
+
+static void nat_reg_done(int err, const struct sip_msg *msg, void *arg)
+{
+ struct nat_registration_test *test = arg;
+ (void)msg;
+ test->error = err;
+ ++test->completed;
+ re_cancel();
+}
+
+static void nat_reg_stop(void *arg)
+{
+ (void)arg;
+ re_cancel();
+}
+
+static void nat_reg_receive(const struct sa *src, struct mbuf *mb, void *arg)
+{
+ struct nat_registration_test *test = arg;
+ struct sip_msg *request_msg = NULL;
+ struct mbuf *reply = NULL;
+ const struct sip_hdr *active = NULL;
+ struct le *le;
+ struct sip_addr contact;
+ struct pl expires;
+ bool removal = false;
+ int error = sip_msg_decode(&request_msg, mb);
+ if (error) goto done;
+ ++test->requests;
+ if (test->bounce) ++test->port;
+ LIST_FOREACH(&request_msg->hdrl, le) {
+  const struct sip_hdr *header = le->data;
+  if (header->id != SIP_HDR_CONTACT || sip_addr_decode(&contact, &header->val)) continue;
+  if (!msg_param_decode(&contact.params, "expires", &expires) && pl_u32(&expires) == 0) {
+   ++test->removals;
+   removal = true;
+  } else active = header;
+ }
+ if (!active && !removal) { error = EBADMSG; goto done; }
+ reply = mbuf_alloc(1024);
+ if (!reply) { error = ENOMEM; goto done; }
+ if (test->delete_combined && removal) test->binding_deleted = true;
+ error = mbuf_printf(reply,
+  "SIP/2.0 200 OK\r\nVia: SIP/2.0/UDP %r;branch=%r%s;rport=%u\r\n"
+  "From: %r\r\nTo: %r;tag=server\r\nCall-ID: %r\r\nCSeq: %u REGISTER\r\n",
+  &request_msg->via.sentby, &request_msg->via.branch,
+  test->omit_received || test->binding_deleted ? "" : ";received=127.0.0.1", test->port,
+  &request_msg->from.val, &request_msg->to.val, &request_msg->callid,
+  request_msg->cseq.num);
+ if (active && !(test->binding_deleted && (removal || test->single_contact == 1))) {
+  error |= mbuf_printf(reply, "Contact: <sip:nat-test@127.0.0.1:%u>;expires=999\r\n",
+                       (unsigned)(test->port+1));
+  if (test->binding_deleted && test->single_contact == 3)
+   error |= mbuf_printf(reply, "Contact: <sip:nat-test@127.0.0.1:%u>;expires=0\r\n", test->port);
+  else if (!(test->binding_deleted && test->single_contact == 2))
+   error |= mbuf_printf(reply, "Contact: %r\r\n", &active->val);
+ }
+ error |= mbuf_write_str(reply, "Content-Length: 0\r\n\r\n");
+ if (!error) {
+  reply->pos = 0;
+  error = udp_send(test->server, src, reply);
+ }
+ done:
+ mem_deref(reply); mem_deref(request_msg);
+ if (error) { test->error = error; re_cancel(); }
+}
+
+int test_sip_nat_registration(void)
+{
+ struct nat_registration_test test = {0};
+ struct sa local, peer, mapped, advertised, other_peer;
+ char registrar[128];
+ int err = 0;
+ #define NAT_REG_ERR(call) do { err = (call); TEST_ERR(err); } while (0)
+ NAT_REG_ERR(sa_set_str(&local, "127.0.0.1", 0));
+ NAT_REG_ERR(udp_listen(&test.server, &local, nat_reg_receive, &test));
+ NAT_REG_ERR(udp_local_get(test.server, &peer));
+ NAT_REG_ERR(sip_alloc(&test.sip, NULL, 32, 32, 32, "nat-reg", NULL, NULL));
+ NAT_REG_ERR(sip_transp_add(test.sip, SIP_TRANSP_UDP, &local));
+ NAT_REG_ERR(re_snprintf(registrar, sizeof(registrar), "sip:%J", &peer) < 0 ? EINVAL : 0);
+ NAT_REG_ERR(sipreg_alloc(&test.reg, test.sip, registrar, "sip:nat-test@lab", NULL,
+                         "sip:nat-test@lab", 60, "nat-test", NULL, 0, 0,
+                         NULL, NULL, false, nat_reg_done, &test, NULL, NULL));
+ test.port = 12345;
+ NAT_REG_ERR(sipreg_send(test.reg));
+ NAT_REG_ERR(re_main_timeout(3000));
+ NAT_REG_ERR(test.error);
+ TEST_ASSERT(test.completed == 1 && test.requests == 2 && test.removals == 1);
+ TEST_ASSERT(sipreg_registered(test.reg));
+ TEST_ASSERT(sipreg_proxy_expires(test.reg) == 60);
+ TEST_ASSERT(sa_port(sipreg_laddr(test.reg)) != test.port);
+ /* A refresh may omit received once the advertised Via host already
+  * matches the observed source. It must renew the mapping, not merely keep
+  * registration green while Contact falls back after the original expiry. */
+ mapped = *sipreg_laddr(test.reg);
+ sa_set_port(&mapped, test.port);
+ NAT_REG_ERR(sip_nat_set(test.sip, sipreg_laddr(test.reg), &peer, &mapped, 1));
+ test.omit_received = true; test.completed = 0; test.requests = 0;
+ NAT_REG_ERR(sipreg_send(test.reg));
+ NAT_REG_ERR(re_main_timeout(3000));
+ NAT_REG_ERR(test.error);
+ TEST_ASSERT(test.completed == 1 && test.requests == 1);
+ TEST_ASSERT(sipreg_registered(test.reg));
+ sys_msleep(1100);
+ sip_nat_addr(test.sip, SIP_TRANSP_UDP, sipreg_laddr(test.reg), &peer, &advertised);
+ TEST_ASSERT(sa_cmp(&advertised, &mapped, SA_ALL));
+ other_peer = peer;
+ sa_set_port(&other_peer, sa_port(&peer) == 65535 ? 65534 : sa_port(&peer) + 1);
+ sip_nat_addr(test.sip, SIP_TRANSP_UDP, sipreg_laddr(test.reg), &other_peer, &advertised);
+ TEST_ASSERT(sa_cmp(&advertised, &mapped, SA_ALL));
+ test.omit_received = false;
+ /* Rebinding must converge within the budget, then fail with normal backoff. */
+ test.bounce = true; test.completed = 0; test.requests = 0;
+ NAT_REG_ERR(sipreg_send(test.reg));
+ NAT_REG_ERR(re_main_timeout(3000));
+ TEST_ASSERT(test.error == ELOOP && test.requests == 3 && test.completed == 1);
+ tmr_start(&test.stop, 300, nat_reg_stop, NULL);
+ NAT_REG_ERR(re_main_timeout(1000));
+ TEST_ASSERT(test.requests == 3);
+ /* A fresh operation resets the immediate-retry budget and can recover. */
+ test.bounce = false; test.error = 0; test.completed = 0; test.requests = 0;
+ test.port = 13000;
+ NAT_REG_ERR(sipreg_send(test.reg));
+ NAT_REG_ERR(re_main_timeout(3000));
+ NAT_REG_ERR(test.error);
+ TEST_ASSERT(test.requests == 2 && test.completed == 1);
+ TEST_ASSERT(sipreg_registered(test.reg));
+ TEST_ASSERT(sipreg_proxy_expires(test.reg) == 60);
+ /* Some peers treat combined old-delete/new-add as deletion. Their 200 has
+  * no binding. Recover once with only the new Contact, never report success
+  * for an empty, unrelated or expired binding after that single retry. */
+ for (unsigned mode = 0; mode < 4; ++mode) {
+  test.delete_combined = true; test.binding_deleted = false;
+  test.single_contact = mode; test.port = (uint16_t)(14000 + mode);
+  test.error = 0; test.completed = 0; test.requests = 0; test.removals = 0;
+  NAT_REG_ERR(sipreg_send(test.reg));
+  NAT_REG_ERR(re_main_timeout(3000));
+  TEST_EQUALS(3, test.requests);
+  TEST_EQUALS(1, test.removals);
+  TEST_EQUALS(1, test.completed);
+  if (!mode) {
+   NAT_REG_ERR(test.error);
+   TEST_ASSERT(sipreg_registered(test.reg));
+   TEST_ASSERT(sipreg_proxy_expires(test.reg) == 60);
+  } else {
+   TEST_ASSERT(test.error == EPROTO && !sipreg_registered(test.reg));
+   tmr_start(&test.stop, 300, nat_reg_stop, NULL);
+   NAT_REG_ERR(re_main_timeout(1000));
+   TEST_ASSERT(test.requests == 3 && test.completed == 1);
+   /* A fresh cycle may recover; no old Contact deletion is repeated. */
+   test.delete_combined = false; test.binding_deleted = false;
+   test.error = 0; test.completed = 0; test.requests = 0; test.removals = 0;
+   NAT_REG_ERR(sipreg_send(test.reg));
+   NAT_REG_ERR(re_main_timeout(3000));
+   NAT_REG_ERR(test.error);
+   TEST_ASSERT(test.requests == 1 && !test.removals && test.completed == 1);
+   TEST_ASSERT(sipreg_registered(test.reg));
+  }
+ }
+ /* A normal active refresh also cannot succeed without its own binding. */
+ test.delete_combined = false; test.binding_deleted = true; test.single_contact = 1;
+ test.error = 0; test.completed = 0; test.requests = 0;
+ NAT_REG_ERR(sipreg_send(test.reg));
+ NAT_REG_ERR(re_main_timeout(3000));
+ TEST_EQUALS(1, test.requests);
+ TEST_ASSERT(test.error == EPROTO && !sipreg_registered(test.reg));
+ test.binding_deleted = false;
+ test.error = 0; test.completed = 0; test.requests = 0;
+ NAT_REG_ERR(sipreg_send(test.reg));
+ NAT_REG_ERR(re_main_timeout(3000));
+ NAT_REG_ERR(test.error);
+ TEST_EQUALS(1, test.requests);
+ TEST_ASSERT(sipreg_registered(test.reg));
+ /* An explicit unregister with no remaining binding is successful and must
+  * never trigger the active-registration compatibility retry. */
+ test.error = 0; test.completed = 0; test.requests = 0; test.removals = 0;
+ sipreg_unregister(test.reg);
+ NAT_REG_ERR(re_main_timeout(3000));
+ NAT_REG_ERR(test.error);
+ TEST_ASSERT(!sipreg_registered(test.reg));
+ TEST_ASSERT(test.requests == 1 && test.removals == 1 && test.completed == 1);
+ tmr_start(&test.stop, 300, nat_reg_stop, NULL);
+ NAT_REG_ERR(re_main_timeout(1000));
+ TEST_ASSERT(test.requests == 1 && test.completed == 1);
+ out:
+ tmr_cancel(&test.stop);
+ mem_deref(test.reg);
+ sip_close(test.sip, true); mem_deref(test.sip); mem_deref(test.server);
+ return err;
+ #undef NAT_REG_ERR
+}
