-		if (!sip_request_provrecv(sess->req)) {
+		/* Established re-INVITEs retain their final-response/ACK owner even
+		 * when teardown precedes the first provisional response. */
+		if (sess->established) {
+			sip_request_cancel_wait(sess->req);
+			mem_ref(sess);
+			wait = true;
+		}
+		else if (!sip_request_provrecv(sess->req)) {
+			sip_request_cancel(sess->req);
 			sess->req = mem_deref(sess->req);
