@@ -414,3 +422,21 @@ enum sdp_neg_state sipsess_sdp_neg_state(const struct sipsess *sess)
 }
 
 bool sipsess_peer_terminated(const struct sipsess *sess) { return sess && sess->peerterm; }
+
+
+/* Retire an unwanted confirmed fork through normal BYE/authentication teardown.
+ * No application call or media stream is allocated for the discarded branch. */
+int sipsess_close_fork(struct sipsess_sock *sock, struct sip_dialog *dlg,
+		       struct sip_auth *auth)
+{
+	struct sipsess *sess = NULL;
+	int err = sipsess_alloc(&sess, sock, "", "application/sdp", NULL,
+		NULL, NULL, false, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
+	if (err) return err;
+	mem_deref(sess->auth);
+	sess->auth = mem_ref(auth);
+	sess->dlg = mem_ref(dlg);
+	sess->established = true;
+	mem_deref(sess);
+	return 0;
+}
