 	ack->cseq = cseq;
 
 	err = sip_drequestf_complete(&ack->req, sock->sip, false, "ACK", dlg, cseq,
@@ -164,3 +170,36 @@ int sipsess_ack_again(struct sipsess_sock *sock, const struct sip_msg *msg)
 
 	return sip_send_conn(sock->sip, ack->tls_sock, ack->tp, &ack->dst, ack->tls_host, ack->mb, NULL, NULL);
 }
+
+
+static bool fork_template(struct le *le, void *arg)
+{
+	struct sipsess_ack *ack = le->data;
+	const struct sip_msg *msg = arg;
+	return ack->allow_forks && ack->cseq == msg->cseq.num &&
+	       sip_dialog_cmp_half(ack->dlg, msg);
+}
+
+/* Reuse dialog/auth/ACK/session ownership; never invent a second transaction stack.
+ * Only locally offered initial INVITEs opt in. Cached ACKs absorb duplicate 2xx.
+ * Cap distinct discarded branches within the existing 64*T1 cache lifetime. */
+int sipsess_ack_fork(struct sipsess_sock *sock, const struct sip_msg *msg)
+{
+	struct sipsess_ack *original;
+	struct sip_dialog *dlg = NULL;
+	int err;
+	if (!sock || !msg || msg->req || !pl_isset(&msg->to.tag)) return EINVAL;
+	original = list_ledata(hash_lookup(sock->ht_ack, hash_joaat_pl(&msg->callid),
+					fork_template, (void *)msg));
+	if (!original) return ENOENT;
+	if (original->forks >= 32) return EOVERFLOW;
+	err = sip_dialog_fork(&dlg, original->dlg, msg);
+	if (err) return err;
+	err = sipsess_ack(sock, dlg, msg->cseq.num, original->auth, NULL, NULL, false);
+	if (!err) {
+		++original->forks;
+		err = sipsess_close_fork(sock, dlg, original->auth);
+	}
+	mem_deref(dlg);
+	return err;
+}
