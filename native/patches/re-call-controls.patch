+/* Rollback is local until the original INVITE receives its final response.
+ * Preserve transaction ownership, ACK generation/cache and session teardown. */
+bool sipsess_cancel_modify(struct sipsess *sess)
+{
+	if (!sess) return false;
+	tmr_cancel(&sess->tmr);
+	sess->modify_pending = false;
+	if (sess->req) {
+		sess->modify_cancelled = true;
+		sip_request_cancel_wait(sess->req);
+		return true;
+	}
+	sess->modify_result = NULL;
+	sess->modify_cancelled = false;
+	sess->desc = mem_deref(sess->desc);
+	sess->neg_state = SDP_NEG_DONE;
+	return false;
+}
+void sipsess_set_modify_result_handler(struct sipsess *sess, sipsess_modify_result_h *handler)
+{
+	if (sess) sess->modify_result = handler;
+}
