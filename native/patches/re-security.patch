+}
+int tls_set_server_verify_handler(struct tls *tls,
+    int (*handler)(void *, void *), void *arg)
+{
+    if (!tls || !handler) return EINVAL;
+    tls->server_verifyh = handler;
+    tls->server_verify_arg = arg;
+    SSL_CTX_set_cert_verify_callback(tls->ctx, server_verify_handler, tls);
+    return 0;
+}
+bool tls_peer_verified_server(const struct tls_conn *tc)
+{
+    char *ip;
+    bool identity;
+    if (!tc || !tc->tls->verify_server || SSL_is_server(tc->ssl)
+        || !SSL_is_init_finished(tc->ssl)
+        || !(SSL_get_verify_mode(tc->ssl) & SSL_VERIFY_PEER)
+        || !SSL_get0_peer_certificate(tc->ssl)
+        || SSL_get_verify_result(tc->ssl) != X509_V_OK) return false;
+    ip = X509_VERIFY_PARAM_get0_host(SSL_get0_param(tc->ssl), 0) ? NULL : X509_VERIFY_PARAM_get1_ip_asc(SSL_get0_param(tc->ssl));
+    identity = ip || X509_VERIFY_PARAM_get0_host(SSL_get0_param(tc->ssl), 0);
+    OPENSSL_free(ip);
+    return identity;
+}
