+static int control_hold_restore(struct call *call)
+{
+	call->on_hold = call->control_hold_previous;
+	for (struct le *le = call->streaml.head; le; le = le->next)
+		stream_hold(le->data, call->on_hold);
+	/* call_modify stopped RX/player while the offer was outstanding. */
+	return call_update_media(call);
+}
+
+static void control_hold_result(int err, uint16_t status, void *arg)
+{
+	struct call *call = arg;
+	if (!call->control_hold_pending) return;
+	bool expired = call->control_hold_expired;
+	call->control_hold_pending = false;
+	call->control_hold_expired = false;
+	sipsess_set_modify_result_handler(call->sess, NULL);
+	if (err == SIP_SECURITY_MEDIA) {
+		sipsess_fail_deferred(call->sess, err);
+		return;
+	}
+	if (expired || err || status < 200 || status >= 300) {
+		int restore_error = control_hold_restore(call);
+		if (restore_error) {
+			sipsess_fail_deferred(call->sess, restore_error);
+			return;
+		}
+	}
+	if (call->controlh)
+		call->controlh(call, expired && !err && status >= 200 && status < 300 ? 4 : 1,
+		 err ? 0 : status, call->control_arg);
+}
+
+void call_set_control_handler(struct call *call, call_control_h *handler, void *arg)
+{
+	if (!call) return;
+	call->controlh = handler;
+	call->control_arg = arg;
+}
+
+void call_cancel_control(struct call *call)
+{
+	if (!call) return;
+	call->control_transfer = false;
+	call->sub = mem_deref(call->sub);
+	if (call->control_hold_pending) {
+		int restore_error = control_hold_restore(call);
+		if (restore_error) {
+			call->control_hold_pending = false;
+			sipsess_fail_deferred(call->sess, restore_error);
+			return;
+		}
+		if (sipsess_cancel_modify(call->sess)) {
+			call->control_hold_expired = true;
+			if (call->controlh) call->controlh(call, 4, 0, call->control_arg);
+		}
+		else control_hold_result(ETIMEDOUT, 0, call);
+	}
+}
+
+/* Re-offer the latest local direction, including an unchanged rollback target. */
+int call_refresh_hold(struct call *call)
+{
+	if (!call || !call->sess || !call->controlh) return EINVAL;
+	call->control_hold_previous = call->on_hold;
+	call->control_hold_pending = true;
+	call->control_hold_expired = false;
+	sipsess_set_modify_result_handler(call->sess, control_hold_result);
+	return call_modify(call);
+}
