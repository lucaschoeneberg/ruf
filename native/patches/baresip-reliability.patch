+/* Decode into the existing session, retaining the last accepted wire description.
+ * Decoder failure must not leave partially replaced remote formats/directions. */
+static int decode_remote_sdp(struct call *call, struct mbuf *body, bool offer)
+{
+	struct mbuf *copy = mbuf_alloc(mbuf_get_left(body));
+	int err;
+	if (!copy) return ENOMEM;
+	err = mbuf_write_mem(copy, mbuf_buf(body), mbuf_get_left(body));
+	if (err) { mem_deref(copy); return err; }
+	copy->pos = 0;
+	err = sdp_decode(call->sdp, body, offer);
+	if (err) {
+		if (call->accepted_sdp && sdp_decode(call->sdp,
+		    call->accepted_sdp, call->accepted_sdp_offer))
+			sipsess_fail_deferred(call->sess, EPROTO);
+		mem_deref(copy);
+		return err;
+	}
+	mem_deref(call->accepted_sdp);
+	call->accepted_sdp = copy;
+	call->accepted_sdp_offer = offer;
+	return 0;
+}
