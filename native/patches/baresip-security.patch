+
+int ua_registration_error(const struct ua *ua)
+{
+    struct le *le;
+    if (!ua) return 0;
+    for (le = ua->regl.head; le; le = le->next) {
+        int err = reg_native_error(le->data);
+        if (err) return err;
+    }
+    return 0;
+}
