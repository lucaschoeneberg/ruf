{
  "name": "sip-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "bun scripts/build-desktop.mjs --dev",
    "dev:web": "bun run --cwd apps/desktop dev",
    "build": "bun run --cwd apps/desktop build",
    "check": "bun run --cwd apps/desktop check",
    "check:versions": "bun scripts/check-versions.mjs",
    "types:generate": "cargo run --locked -p phone-core --example export_types",
    "format": "bun fmt && cargo fmt --all",
    "format:check": "bun fmt --check && cargo fmt --all -- --check",
    "desktop:build": "bun scripts/build-desktop.mjs",
    "appstore:prepare": "bun scripts/prepare-app-store.mjs",
    "appstore:screenshots": "bun scripts/capture-app-store.mjs",
    "native:build": "bun native/build.mjs",
    "dev:native": "bun scripts/build-desktop.mjs --dev --features native",
    "lab:up": "docker compose -f tests/interop/asterisk/compose.yml up -d --wait",
    "lab:down": "docker compose -f tests/interop/asterisk/compose.yml down",
    "test:asterisk": "bun scripts/asterisk-smoke.mjs",
    "test:native": "bun scripts/check-native-workspace.mjs",
    "test:macos-audio": "bun scripts/check-macos-audio.mjs",
    "test:macos-call-notifications": "bun scripts/check-macos-call-notifications.mjs",
    "test:macos-notification-timeouts": "bun scripts/check-macos-notification-timeouts.mjs",
    "test:macos-contacts": "bun scripts/check-macos-contacts.mjs",
    "test:macos-contact-timeouts": "bun scripts/check-macos-contact-timeouts.mjs",
    "test:macos-login-item": "bun scripts/check-macos-login-item.mjs",
    "test:sip-diagnostics": "bun scripts/check-sip-diagnostics.mjs",
    "test:sip-lifetimes": "bun scripts/check-sip-lifetimes.mjs",
    "test:network-roam": "bun scripts/check-network-roam.mjs",
    "test:ui": "bun test tests/ui",
    "test:ui:flows": "bun scripts/check-ui-flows.mjs"
  }
}
