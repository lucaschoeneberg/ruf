{
  "name": "sip-workspace",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "bun scripts/build-desktop.ts --dev",
    "dev:web": "bun run --cwd apps/desktop dev",
    "build": "bun run --cwd apps/desktop build",
    "clean": "bun scripts/clean.ts",
    "check": "bun run i18n:check && bun run check:tooling && bun run --cwd apps/desktop check",
    "i18n:check": "bun scripts/check-i18n.ts",
    "check:tooling": "bun --bun tsc --project tsconfig.tooling.json",
    "check:versions": "bun scripts/check-versions.ts",
    "types:generate": "cargo run --locked -p phone-core --example export_types",
    "format": "bun fmt && cargo fmt --all",
    "format:check": "bun fmt --check && cargo fmt --all -- --check",
    "desktop:build": "bun scripts/build-desktop.ts",
    "appstore:prepare": "bun scripts/prepare-app-store.ts",
    "appstore:screenshots": "bun scripts/capture-app-store.ts",
    "media:repository": "bun scripts/capture-repository.ts",
    "native:build": "bun native/build.ts",
    "dev:native": "bun scripts/build-desktop.ts --dev --features native",
    "lab:up": "docker compose -f tests/interop/asterisk/compose.yml up -d --wait",
    "lab:down": "docker compose -f tests/interop/asterisk/compose.yml down",
    "test:asterisk": "bun scripts/asterisk-smoke.ts",
    "test:native": "bun scripts/check-native-workspace.ts",
    "test:macos-audio": "bun scripts/check-macos-audio.ts",
    "test:macos-call-notifications": "bun scripts/check-macos-call-notifications.ts",
    "test:macos-notification-timeouts": "bun scripts/check-macos-notification-timeouts.ts",
    "test:macos-contacts": "bun scripts/check-macos-contacts.ts",
    "test:macos-contact-timeouts": "bun scripts/check-macos-contact-timeouts.ts",
    "test:macos-login-item": "bun scripts/check-macos-login-item.ts",
    "test:sip-diagnostics": "bun scripts/check-sip-diagnostics.ts",
    "test:sip-lifetimes": "bun scripts/check-sip-lifetimes.ts",
    "test:network-roam": "bun scripts/check-network-roam.ts",
    "test:ui": "bun test tests/ui",
    "test:ui:flows": "bun scripts/check-ui-flows.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "playwright-core": "1.65.0-alpha-2026-10-30"
  }
}
